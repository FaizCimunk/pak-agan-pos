# Minuman Herbal Pak Agan - Konfigurasi Lingkungan Supabase
# Salin file ini menjadi .env.local dan isi dengan kredensial Supabase Anda:

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Storage bucket untuk bukti transfer pencairan belanja/kasbon:
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=bukti-transfer

# Catatan: Jika variabel Supabase di atas belum diisi atau perangkat offline,
# sistem POS otomatis beralih ke Hybrid In-Memory & IndexedDB Local Persistence
# sehingga aplikasi tetap dapat berjalan 100% normal tanpa error.
